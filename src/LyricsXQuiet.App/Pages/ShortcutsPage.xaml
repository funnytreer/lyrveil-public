<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:LyricsXQuiet.App.State"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" xmlns:windows="clr-namespace:LyricsXQuiet.App.Windows"
    xmlns:playback="clr-namespace:LyricsXQuiet.Core.Playback;assembly=LyricsXQuiet.Core"
    x:Class="LyricsXQuiet.App.Pages.ShortcutsPage">
    <ScrollViewer Style="{StaticResource SettingsScroller}">
        <StackPanel Style="{StaticResource SettingsPage}">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="全局快捷键" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="BindingsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="清除" Tag="{Binding Action}"
                                        Click="ClearBinding" />
                                    <Button DockPanel.Dock="Right" Margin="4,0" Content="修改" Tag="{Binding Action}"
                                        Click="ArmCapture" PreviewKeyDown="CaptureKey"
                                        LostKeyboardFocus="EndCapture" />
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface.Subtle}"
                                        Padding="10,3" CornerRadius="6">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Gesture}"
                                            Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Feedback" AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource Text.Secondary}" Margin="0,8" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="使用推荐组合" Click="Recommend" />
                        <Button Content="全部清除" Margin="8,0" Click="ClearAll" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
