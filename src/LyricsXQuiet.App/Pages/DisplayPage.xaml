<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:LyricsXQuiet.App.State"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" xmlns:windows="clr-namespace:LyricsXQuiet.App.Windows"
    xmlns:playback="clr-namespace:LyricsXQuiet.Core.Playback;assembly=LyricsXQuiet.Core"
    x:Class="LyricsXQuiet.App.Pages.DisplayPage">
    <ScrollViewer Style="{StaticResource SettingsScroller}">
        <StackPanel Style="{StaticResource SettingsPage}">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="外观与显示" />
            <Border x:Name="Wallpaper" CornerRadius="12" MinHeight="150" Margin="0,0,0,12" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#123540" Offset="0" />
                                    <GradientStop Color="#453D49" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked,ElementName=Mist}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush>
                                            <GradientStop Color="#CADDE1" Offset="0" />
                                            <GradientStop Color="#EEF0DB" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked,ElementName=Paper}" Value="True">
                                <Setter Property="Background" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <WrapPanel HorizontalAlignment="Right">
                        <RadioButton GroupName="Wallpaper" Style="{StaticResource Pill}" Content="夜色"
                            IsChecked="True" />
                        <RadioButton x:Name="Mist" GroupName="Wallpaper" Style="{StaticResource Pill}" Content="浅雾" />
                        <RadioButton x:Name="Paper" GroupName="Wallpaper" Style="{StaticResource Pill}"
                            Content="白底文档" />
                    </WrapPanel>
                    <Border CornerRadius="10" HorizontalAlignment="Center" Padding="15,6" Margin="0,8">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Settings.BackgroundColor}"
                                Opacity="{Binding Settings.BackgroundOpacity}" />
                        </Border.Background>
                        <StackPanel>
                            <Grid>
                                <windows:OutlinedLyricText x:Name="PreviewMainOutline">
                                    <TextBlock x:Name="PreviewMain" HorizontalAlignment="Center"
                                        Text="中文 · English · 日本語 · 한국어" Foreground="{Binding Settings.LyricColor}"
                                        FontFamily="{Binding Settings.FontFamilyName,Converter={StaticResource LyricFontFamilyConverter}}"
                                        FontSize="{Binding Settings.FontSize}"
                                        FontWeight="{Binding Settings.LyricFontWeight}" />
                                </windows:OutlinedLyricText>
                                <TextBlock x:Name="PreviewProgress" Text="{Binding Text,ElementName=PreviewMain}"
                                    Foreground="{Binding Settings.ProgressColor}"
                                    FontFamily="{Binding FontFamily,ElementName=PreviewMain}"
                                    FontSize="{Binding FontSize,ElementName=PreviewMain}"
                                    FontWeight="{Binding FontWeight,ElementName=PreviewMain}"
                                    HorizontalAlignment="Center">
                                    <TextBlock.Clip>
                                        <RectangleGeometry x:Name="PreviewClip" />
                                    </TextBlock.Clip>
                                </TextBlock>
                            </Grid>
                            <windows:OutlinedLyricText x:Name="PreviewSubOutline">
                                <TextBlock x:Name="PreviewSub" HorizontalAlignment="Center" Text="第二行翻译或下一句"
                                    FontFamily="{Binding FontFamily,ElementName=PreviewMain}"
                                    Foreground="{Binding Settings.LyricColor}"
                                    Opacity="{Binding Settings.SecondaryLineOpacity}" />
                            </windows:OutlinedLyricText>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="应用界面主题" />
                        <Border Background="{DynamicResource Surface.Tray}" HorizontalAlignment="Right" CornerRadius="8" Padding="3">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="UiThemeMode" Content="跟随系统"
                                    IsChecked="{Binding Settings.UiThemeMode, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="UiThemeMode" Content="宣纸雾白"
                                    IsChecked="{Binding Settings.UiThemeMode, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="UiThemeMode" Content="松烟暮灰"
                                    IsChecked="{Binding Settings.UiThemeMode, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=Dark}" />
                            </WrapPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="文字护底" />
                        <Border Background="{DynamicResource Surface.Tray}" HorizontalAlignment="Right" CornerRadius="8" Padding="3">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TextBackingStyle" Content="无"
                                    IsChecked="{Binding Settings.TextBackingStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=None}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TextBackingStyle" Content="暗色柔影"
                                    IsChecked="{Binding Settings.TextBackingStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=SoftShadow}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TextBackingStyle" Content="清晰描边"
                                    IsChecked="{Binding Settings.TextBackingStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=CrispOutline}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TextBackingStyle" Content="经典微光"
                                    IsChecked="{Binding Settings.TextBackingStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=ProgressGlow}" />
                            </WrapPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="歌词字重" />
                        <Border Background="{DynamicResource Surface.Tray}" HorizontalAlignment="Right" CornerRadius="8" Padding="3">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="LyricFontWeight" Content="标准"
                                    IsChecked="{Binding Settings.LyricFontWeight, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=Normal}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="LyricFontWeight" Content="半粗"
                                    IsChecked="{Binding Settings.LyricFontWeight, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=SemiBold}" />
                            </WrapPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="切行动画" />
                        <Border Background="{DynamicResource Surface.Tray}" HorizontalAlignment="Right" CornerRadius="8" Padding="3">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="LineTransitionStyle" Content="纯淡入"
                                    IsChecked="{Binding Settings.LineTransitionStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=FadeOnly}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="LineTransitionStyle" Content="上滑淡入"
                                    IsChecked="{Binding Settings.LineTransitionStyle, Mode=TwoWay, Converter={StaticResource ValueIs}, ConverterParameter=SlideFade}" />
                            </WrapPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="副行字号比例" />
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                            Text="{Binding Settings.SecondaryLineScale,StringFormat={}{0:P0}}" />
                        <Slider VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="副行字号比例" Style="{StaticResource ModernSlider}"
                            Minimum="0.7" Maximum="1" Value="{Binding Settings.SecondaryLineScale}" />
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBlock VerticalAlignment="Center" Width="140" Text="副行不透明度" />
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                            Text="{Binding Settings.SecondaryLineOpacity,StringFormat={}{0:P0}}" />
                        <Slider VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="副行不透明度" Style="{StaticResource ModernSlider}"
                            Minimum="0.5" Maximum="1" Value="{Binding Settings.SecondaryLineOpacity}" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="外观方案" FontSize="14" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Height="36" MinWidth="76" Margin="10,0,0,0" Content="应用" Click="ApplyPreset" />
                        <ComboBox x:Name="PresetList" Height="36" DisplayMemberPath="Name" AutomationProperties.Name="外观方案" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Height="36" MinWidth="112" Margin="10,0,0,0" Content="保存当前外观" Click="SavePreset" />
                        <Grid>
                            <TextBox x:Name="PresetName" Height="36" MaxLength="80" ToolTip="输入自定义方案名称"
                                AutomationProperties.Name="自定义方案名称" />
                            <TextBlock Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                Text="输入新方案名称，例如：深夜阅读…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PresetName}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="PresetFeedback" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="锁定歌词位置并点击穿透"
                        IsChecked="{Binding Settings.Locked}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="鼠标经过时隐藏整个歌词（仅锁定时）"
                        IsChecked="{Binding Settings.HoverHide}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="显示双行歌词（翻译优先，否则显示下一句）"
                        IsChecked="{Binding Settings.DoubleLine}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="歌词渐变效果（逐行歌词会平滑估算）"
                        IsChecked="{Binding Settings.ProgressiveHighlight}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="前奏或无歌词时显示歌名和歌手"
                        IsChecked="{Binding Settings.ShowTrackInfoWhenNoLyrics}" />
                    <TextBlock Margin="32,-7,0,14" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                        TextWrapping="Wrap" Text="只在第一句歌词开始前或整首没有同步歌词时显示；歌曲中途的间奏不会重复显示。" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="从屏幕截图和录屏中排除歌词"
                        IsChecked="{Binding Settings.ExcludeFromCapture}" />
                    <TextBlock Margin="32,-7,0,14" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                        TextWrapping="Wrap" Text="由 Windows 提供显示排除，部分旧版系统或录屏软件可能不遵守。" />
                    <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,4,0,16" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="居中移动"
                        IsChecked="{Binding Settings.CenterAlignedDragging}" />
                    <TextBlock Margin="32,-7,0,14" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                        TextWrapping="Wrap" Text="开启后，解锁拖动只调整上下位置，歌词会实时保持当前显示器水平居中。" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="歌词位置" />
                            <TextBlock Margin="0,3,16,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="解锁后可用鼠标拖动；也可随时恢复到默认位置。" />
                        </StackPanel>
                        <Button x:Name="ResetLyricsPositionButton" Grid.Column="1" VerticalAlignment="Center"
                            Content="恢复默认位置" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                        Text="文字" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" Text="字体" />
                        <ComboBox Grid.Column="1" AutomationProperties.Name="歌词字体"
                            AutomationProperties.HelpText="选择桌面歌词使用的字体。" VerticalAlignment="Center"
                            ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding Settings.FontFamilyName}"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="字号" />
                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="16–42 px" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource ModernSlider}"
                            AutomationProperties.Name="歌词字号" AutomationProperties.HelpText="范围 16 到 42 像素。"
                            Minimum="16" Maximum="42" TickFrequency="1" Value="{Binding Settings.FontSize}" />
                        <Border Grid.Column="2" Margin="12,0,0,0" Padding="8,5"
                            Background="{DynamicResource Surface.Subtle}" CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Secondary}"
                                Text="{Binding Settings.FontSize, StringFormat={}{0:0} px}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                        Text="颜色与背景" />
                    <Grid Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="背景深浅" />
                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="只调整背景透明度" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource ModernSlider}"
                            AutomationProperties.Name="歌词背景透明度" AutomationProperties.HelpText="零表示无背景，百分之百表示完全不透明。"
                            Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding Settings.BackgroundOpacity}" />
                        <Border Grid.Column="2" Margin="12,0,0,0" Padding="8,5"
                            Background="{DynamicResource Surface.Subtle}" CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Secondary}"
                                Text="{Binding Settings.BackgroundOpacity, StringFormat={}{0:P0}}" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,14,0,4" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="歌词颜色" />
                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="普通歌词与第二行" />
                        </StackPanel>
                        <Button x:Name="LyricColorButton" Grid.Column="1" Width="126" Padding="10,6"
                            Background="{DynamicResource Surface.Card}" AutomationProperties.Name="选择歌词颜色"
                            HorizontalContentAlignment="Left" FontWeight="Normal"
                            BorderBrush="{DynamicResource Border.Hairline}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Margin="0,0,8,0" CornerRadius="5"
                                    Background="{Binding Settings.LyricColor}"
                                    BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Settings.LyricColor}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="进度颜色" />
                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="当前句的逐字覆盖" />
                        </StackPanel>
                        <Button x:Name="ProgressColorButton" Grid.Column="1" Width="126" Padding="10,6"
                            Background="{DynamicResource Surface.Card}" AutomationProperties.Name="选择歌词进度颜色"
                            HorizontalContentAlignment="Left" FontWeight="Normal"
                            BorderBrush="{DynamicResource Border.Hairline}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Margin="0,0,8,0" CornerRadius="5"
                                    Background="{Binding Settings.ProgressColor}"
                                    BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Settings.ProgressColor}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Primary}" Text="背景颜色" />
                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                Text="深浅仍由上方滑杆控制" />
                        </StackPanel>
                        <Button x:Name="BackgroundColorButton" Grid.Column="1" Width="126" Padding="10,6"
                            Background="{DynamicResource Surface.Card}" AutomationProperties.Name="选择歌词背景颜色"
                            HorizontalContentAlignment="Left" FontWeight="Normal"
                            BorderBrush="{DynamicResource Border.Hairline}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Margin="0,0,8,0" CornerRadius="5"
                                    Background="{Binding Settings.BackgroundColor}"
                                    BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Settings.BackgroundColor}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource HintText}" Text="颜色只调整 RGB；背景透明度仍单独控制，歌词和进度不提供透明度调节。" />
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,20,0" VerticalAlignment="Center" FontSize="11.5"
                    Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="恢复本页的显示、文字、颜色与歌词位置，不影响其他设置。" />
                <Button x:Name="ResetLyricsDisplayButton" Grid.Column="1" VerticalAlignment="Center"
                    Content="恢复默认设置" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
