<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:LyricsXQuiet.App.State"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" xmlns:windows="clr-namespace:LyricsXQuiet.App.Windows"
    xmlns:playback="clr-namespace:LyricsXQuiet.Core.Playback;assembly=LyricsXQuiet.Core"
    x:Class="LyricsXQuiet.App.Pages.ExperimentalPage">
    <ScrollViewer Style="{StaticResource SettingsScroller}">
        <StackPanel Style="{StaticResource SettingsPage}">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="实验性功能" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AutoRepairNetEaseSyncCheckBox" Margin="0,16,0,0" Content="自动修复网易云更新后的同步"
                        IsChecked="{Binding Settings.AutoRepairNetEaseSync}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.PlayerFollowMode}" Value="Monitor">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <TextBlock Margin="32,6,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                        TextWrapping="Wrap" Text="自动维护桌面和任务栏的组合入口。若精确进度丢失，在暂停约 8 秒后重新打开网易云一次，播放位置可能重置；播放中不会打断。" />
                    <TextBlock Margin="32,6,0,0" FontSize="11.5" Foreground="{DynamicResource Danger.Text}"
                        TextWrapping="Wrap" Text="{Binding State.NetEaseRecoveryStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.ShowNetEasePreciseSyncHelp}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                            Text="{Binding State.NetEasePreciseSyncTitle}" />
                        <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                            TextWrapping="Wrap" Text="{Binding State.NetEasePreciseSyncDescription}" />
                    </StackPanel>
                    <Button x:Name="OpenNetEasePreciseSyncHelpButton" Grid.Column="1" Width="132"
                        VerticalAlignment="Center" AutomationProperties.Name="查看网易云实验性精确同步启用方式"
                        Content="{Binding State.NetEasePreciseSyncActionText}" />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource HintText}"
                Text="这里收纳需要额外启用、且可能随播放器版本变化的功能；实验功能失效时，词间会自动退回系统媒体会话或本地计时。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
