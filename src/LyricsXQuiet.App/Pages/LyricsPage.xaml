<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:LyricsXQuiet.App.State"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" xmlns:windows="clr-namespace:LyricsXQuiet.App.Windows"
    xmlns:playback="clr-namespace:LyricsXQuiet.Core.Playback;assembly=LyricsXQuiet.Core"
    x:Class="LyricsXQuiet.App.Pages.LyricsPage">
    <ScrollViewer Style="{StaticResource SettingsScroller}">
        <StackPanel Style="{StaticResource SettingsPage}">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="歌词来源与过滤" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="Normal" FontSize="15" Foreground="{DynamicResource Text.Primary}"
                        Text="歌词文件夹" />
                    <TextBlock Margin="0,5,0,12" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                        TextWrapping="Wrap" Text="自动匹配、手动选择和导入的歌词都会保存为可读的 LRC 文件。可以预览并整理已被手选歌词替代、完全重复或无法读取的自动缓存。" />
                    <Border Padding="10,8" Background="{DynamicResource Surface.Subtle}" CornerRadius="7">
                        <TextBlock Text="{Binding Settings.LyricsDirectory}"
                            Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="OpenLyricsDirectoryButton" Margin="0,0,8,0" Content="打开文件夹" />
                        <Button x:Name="ChooseLyricsDirectoryButton" Margin="0" Content="更改位置…"
                            ToolTip="只迁移 LRC 歌词；非词间专用目录中的其他文件绝不会移动或删除" />
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,14,0,6" />
                    <Expander Style="{StaticResource SettingsExpander}" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                                    Text="管理歌词缓存" />
                                <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                    Text="预览并整理重复或已被替换的自动缓存，也可以恢复最近一次整理。" />
                            </StackPanel>
                        </Expander.Header>
                        <WrapPanel>
                            <Button x:Name="OrganizeLyricsCacheButton" Margin="0,0,8,0" Content="整理歌词缓存…"
                                ToolTip="先扫描和预览，确认后才把多余的应用缓存移入可恢复备份" />
                            <Button x:Name="RestoreLyricsCacheButton" Content="恢复最近整理的文件…"
                                ToolTip="恢复最近一次整理时移入备份的歌词，不会覆盖现有文件" />
                        </WrapPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <pages:CalibrationNotice x:Name="Calibration" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自动选择最佳歌词" FontSize="15" FontWeight="Normal"
                                Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Margin="0,4,0,0" Text="优先使用已确认的本地歌词，再按歌曲版本、专辑、时长和逐字质量比较可用来源。" FontSize="11.5"
                                Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource Accent.Primary}" FontWeight="Normal" Text="推荐" />
                    </Grid>
                    <WrapPanel Margin="0,16,0,4">
                        <Button x:Name="SearchLyricsButton" Margin="0,0,8,0" Content="选择当前歌曲歌词…" />
                        <Button x:Name="RetryLyricsButton" Content="重新自动匹配"
                            ToolTip="忽略当前自动缓存并重新比较全部已启用来源；手动选择时仍可随时改回" />
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,14,0,6" />
                    <Expander Style="{StaticResource SettingsExpander}" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                                    Text="高级：选择歌词来源" />
                                <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                    Text="通常无需更改；关闭某个来源后，自动匹配将跳过它。" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LRCLIB" FontWeight="Normal"
                                        Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Margin="0,3,0,0" Text="公开同步歌词服务，无需登录" FontSize="11.5"
                                        Foreground="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
                                    FocusVisualStyle="{StaticResource SettingsCenteredCheckBoxFocusVisual}"
                                    AutomationProperties.Name="启用 LRCLIB" Margin="0" VerticalAlignment="Center"
                                    ToolTip="启用 LRCLIB" IsChecked="{Binding Settings.EnableLrclibLyrics}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="网易云音乐" FontWeight="Normal"
                                        Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Margin="0,3,0,0" Text="支持逐行、逐字与翻译歌词" FontSize="11.5"
                                        Foreground="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
                                    FocusVisualStyle="{StaticResource SettingsCenteredCheckBoxFocusVisual}"
                                    AutomationProperties.Name="启用网易云音乐歌词来源" Margin="0" VerticalAlignment="Center"
                                    ToolTip="启用网易云音乐歌词来源" IsChecked="{Binding Settings.EnableNetEaseLyrics}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="QQ 音乐" FontWeight="Normal"
                                        Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Margin="0,3,0,0" Text="同步歌词与翻译" FontSize="11.5"
                                        Foreground="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
                                    FocusVisualStyle="{StaticResource SettingsCenteredCheckBoxFocusVisual}"
                                    AutomationProperties.Name="启用 QQ 音乐歌词来源" Margin="0" VerticalAlignment="Center"
                                    ToolTip="启用 QQ 音乐歌词来源" IsChecked="{Binding Settings.EnableQqMusicLyrics}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="酷狗音乐" FontWeight="Normal"
                                        Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Margin="0,3,0,0" Text="支持 KRC 逐字歌词" FontSize="11.5"
                                        Foreground="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
                                    FocusVisualStyle="{StaticResource SettingsCenteredCheckBoxFocusVisual}"
                                    AutomationProperties.Name="启用酷狗音乐歌词来源" Margin="0" VerticalAlignment="Center"
                                    ToolTip="启用酷狗音乐歌词来源" IsChecked="{Binding Settings.EnableKugouLyrics}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="检查来源" Click="CheckHealth" />
                    <StackPanel>
                        <TextBlock Text="歌词来源状态" FontWeight="Normal" />
                        <TextBlock Text="{Binding State.SourceHealth}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                        Text="歌词内容" />
                    <CheckBox Margin="0,14,0,0" Style="{StaticResource SettingsCheckBox}"
                        Content="显示制作人员信息（词曲、编曲、录音、封面等）" IsChecked="{Binding Settings.ShowLyricsCredits}" />
                    <TextBlock Margin="32,4,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                        TextWrapping="Wrap" Text="关闭时自动隐藏常见制作名单；只影响显示，不会改写歌词文件。" />
                    <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,14,0,6" />
                    <Expander Style="{StaticResource SettingsExpander}" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                                    Text="高级：自定义过滤规则" />
                                <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                    Text="适合需要清理特殊来源杂项的用户。" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingsCheckBox}" Content="启用自定义正则规则"
                                IsChecked="{Binding Settings.LyricsFilterEnabled}" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.LyricsFilterEnabled}"
                                                Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource Text.Primary}"
                                    Text="正则表达式（每行一条）" />
                                <TextBox x:Name="FilterPatternsBox" AutomationProperties.Name="歌词过滤正则表达式"
                                    AutomationProperties.HelpText="每行一条正则表达式；过滤仅影响显示，不改写歌词文件。" Height="170"
                                    Padding="10" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                    Text="{Binding Settings.LyricsFilterPatterns, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <TextBlock x:Name="FilterValidationText" AutomationProperties.Name="歌词过滤规则验证状态"
                                    AutomationProperties.LiveSetting="Polite" Margin="0,9,0,0" FontSize="11.5"
                                    TextWrapping="Wrap" />
                                <Button x:Name="ResetLyricsFiltersButton" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Content="恢复默认规则" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
