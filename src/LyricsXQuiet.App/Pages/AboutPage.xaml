<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:LyricsXQuiet.App.State"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" xmlns:windows="clr-namespace:LyricsXQuiet.App.Windows"
    xmlns:playback="clr-namespace:LyricsXQuiet.Core.Playback;assembly=LyricsXQuiet.Core"
    x:Class="LyricsXQuiet.App.Pages.AboutPage">
    <ScrollViewer Style="{StaticResource SettingsScroller}">
        <StackPanel Style="{StaticResource SettingsPage}">
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="关于" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="词间 · Lyrveil" FontSize="17" FontWeight="SemiBold"
                        Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Margin="0,4,0,14" Text="{Binding VersionDisplay, StringFormat=版本 · {0}}"
                        FontSize="12" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock MaxWidth="600" HorizontalAlignment="Left" FontSize="13" TextWrapping="Wrap"
                        LineHeight="20" Foreground="{DynamicResource Text.Secondary}"
                        Text="一个低干扰的第三方桌面歌词工具。视觉与交互参考 LyricsX，Windows 端独立重写实现。" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                        Text="当前运行状态" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="播放器" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                            Text="{Binding State.PlayerDisplay}" />
                        <TextBlock Grid.Row="1" Margin="0,9,0,0" Foreground="{DynamicResource Text.Secondary}"
                            Text="歌词与同步" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"
                            Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                            Text="{Binding State.LyricsStatus}" />
                    </Grid>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button x:Name="CheckPlayerCompatibilityButton" Margin="0,0,8,0"
                            AutomationProperties.Name="检查当前播放器兼容性" Content="检查播放器兼容性…" />
                        <Button x:Name="CopyDiagnosticsButton" AutomationProperties.Name="复制不含歌曲名称的诊断摘要"
                            Content="复制诊断摘要" />
                        <TextBlock x:Name="DiagnosticsStatusText" AutomationProperties.Name="诊断摘要复制状态"
                            AutomationProperties.LiveSetting="Polite" Margin="12,0,0,0" VerticalAlignment="Center"
                            FontSize="11.5" Foreground="{DynamicResource Accent.Primary}" />
                    </StackPanel>
                    <TextBlock Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                        TextWrapping="Wrap" Text="诊断摘要不包含歌曲名、歌手、歌词内容或歌词文件夹路径。" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}"
                        Text="隐私与数据边界" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="播放器信息" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                            Text="只在本机读取受支持播放器公开给 Windows 的媒体信息。" />
                        <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{DynamicResource Text.Secondary}"
                            Text="歌词请求" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                            Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                            Text="仅在匹配歌词时访问已启用的来源；本地歌词与手动导入不依赖网络。" />
                        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource Text.Secondary}"
                            Text="网易云增强" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                            Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                            Text="实验性精确进度只连接本机回环地址，不安装插件、不修改播放器目录，也不保存播放历史。" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
