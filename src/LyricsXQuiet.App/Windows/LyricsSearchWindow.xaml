<Window x:Class="LyricsXQuiet.App.Windows.LyricsSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages"
        Foreground="{DynamicResource Text.Primary}"
        Title="选择歌词 · 词间"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        Icon="/Assets/lyrveil-app.ico"
        Background="{DynamicResource Surface.Canvas}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Surface.Card}" Margin="0,0,0,1">
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="手动选择歌词" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                <TextBlock Margin="0,4,0,0" Text="可修改歌名或歌手，查找现场版、重制版等不同版本。"
                           FontSize="11.5" Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,18,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,5" Text="歌名" Foreground="{DynamicResource Text.Secondary}" />
                <TextBox x:Name="TitleBox"
                         AutomationProperties.Name="歌名" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,5" Text="歌手" Foreground="{DynamicResource Text.Secondary}" />
                <TextBox x:Name="ArtistBox"
                         AutomationProperties.Name="歌手" />
            </StackPanel>
            <Button x:Name="SearchButton"
                    Grid.Column="4"
                    Margin="0,22,0,0"
                    Content="搜索"
                    Click="OnSearchClick" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="24,3">
            <UniformGrid Rows="1" HorizontalAlignment="Left"><RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="全部" Tag="" IsChecked="True" Click="FilterSource" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="网易云" Tag="网易云音乐" Click="FilterSource" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="QQ" Tag="QQ 音乐" Click="FilterSource" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="酷狗" Tag="酷狗音乐" Click="FilterSource" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="LRCLIB" Tag="LRCLIB" Click="FilterSource" /></UniformGrid>
            <pages:CalibrationNotice x:Name="Calibration"/>
            <Border Background="{DynamicResource Accent.Soft}" CornerRadius="6" Padding="6,3"><TextBlock x:Name="Recommendation" TextWrapping="Wrap" Foreground="{DynamicResource Accent.Primary}"/></Border>
            <TextBlock x:Name="StatusText"
                   AutomationProperties.Name="歌词搜索状态"
                   AutomationProperties.LiveSetting="Polite"
                   Grid.Row="2"
                   Margin="24,4,24,8"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="正在准备搜索…" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="24,8,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" CornerRadius="10">
                <ListBox x:Name="ResultsList"
                         AutomationProperties.Name="歌词候选版本"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8"
                                        AutomationProperties.Name="{Binding AccessibilityName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="{Binding RecommendationText}"
                                               FontSize="11.5"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource Accent.Primary}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Text="{Binding ArtistAndDuration}"
                                           FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AlbumAndProvider}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            Background="{DynamicResource Accent.Soft}"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding QualitySummary}"
                                                   FontSize="11.5"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource Accent.Primary}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1"
                    CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="歌词预览" FontWeight="Normal" Foreground="{DynamicResource Text.Primary}" />
                    <TextBox x:Name="PreviewBox"
                             AutomationProperties.Name="歌词预览"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             Padding="0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource Text.Secondary}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="24,12,24,14">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                       Text="选中后会保存到歌词文件夹，下次播放同一首歌时优先使用。" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="取消" IsCancel="True" Click="CloseSearch" />
                <Button x:Name="UseButton"
                        Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        Content="使用所选歌词"
                        IsEnabled="False"
                        Click="OnUseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
