<Window x:Class="LyricsXQuiet.App.Windows.CompanionPlayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource Text.Primary}"
        Title="伴随播放器 · 词间"
        Width="720"
        Height="590"
        MinWidth="640"
        MinHeight="520"
        Icon="/Assets/lyrveil-app.ico"
        Background="{DynamicResource Surface.Canvas}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Surface.Card}">
            <StackPanel Margin="26,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="选择伴随播放器"
                           FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                <TextBlock x:Name="HeaderDescriptionText" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                           Text="快捷方式会保留播放器原来的名称和图标，不会显示“+ 词间”。" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="24,18,24,10" Padding="16,13"
                Background="{DynamicResource Accent.Soft}" CornerRadius="10">
            <CheckBox x:Name="AutoSelectCheckBox"
                      Style="{StaticResource SettingsCheckBox}"
                      Margin="0"
                      Content="自动勾选检测到的播放器（推荐）"
                      IsChecked="True"
                      Checked="OnAutoSelectChanged" />
        </Border>

        <Grid Grid.Row="2" Margin="24,2,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DetectionStatusText"
                       AutomationProperties.Name="播放器检测状态"
                       AutomationProperties.LiveSetting="Polite"
                       Margin="2,0,0,8"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="12" Text="正在检测已安装的播放器…" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlayerOptionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,9" Padding="14,12"
                                    Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Hairline}"
                                    BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Margin="0" VerticalAlignment="Center"
                                              Style="{StaticResource SettingsCheckBox}"
                                              FocusVisualStyle="{StaticResource SettingsCenteredCheckBoxFocusVisual}"
                                              AutomationProperties.Name="{Binding Player.DisplayName}"
                                              IsChecked="{Binding IsSelected}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="Normal"
                                               Foreground="{DynamicResource Text.Primary}" Text="{Binding Player.DisplayName}" />
                                    <StackPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PlayerStatus" FontSize="12"
                                                   Foreground="{DynamicResource Danger.Text}" Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                                   Visibility="{Binding PathControlsVisibility}"
                                                   Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Padding="11,6" Tag="{Binding}"
                                            Visibility="{Binding PathControlsVisibility}"
                                            Content="手动定位…" Click="OnBrowsePlayerClick" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                    <Setter TargetName="PlayerStatus" Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="24,14,24,18">
            <TextBlock x:Name="FooterHintText" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                       Text="以后从桌面上原样的播放器图标启动即可。" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="取消" IsCancel="True" />
                <Button x:Name="ConfirmButton" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Primary}"
                        Content="创建所选快捷方式" Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
