<Window x:Class="LyricsXQuiet.App.Windows.TrayContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="236"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Title="词间托盘菜单"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="12.5"
        FontWeight="Normal"
        TextOptions.TextHintingMode="Auto"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        automation:AutomationProperties.Name="词间托盘菜单"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>

        <Style x:Key="TrayMenuRowStyle" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border x:Name="ItemSurface"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Surface.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Danger.Text}" />
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Danger.Soft}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger" />
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Danger.Text}" />
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Danger.Soft}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuIconStyle" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="ExitIconStyle" TargetType="Path" BasedOn="{StaticResource TrayMenuIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Danger.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Danger.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrayMenuLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:ButtonBase}}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="10" CornerRadius="10" Background="{DynamicResource Surface.Card}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.16" RenderingBias="Performance" />
            </Border.Effect>
        </Border>
        <Border Margin="10" Padding="5" CornerRadius="10" Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1">
            <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                <Button x:Name="QuickPanelButton"
                        Style="{StaticResource TrayMenuRowStyle}"
                        automation:AutomationProperties.Name="快速调节"
                        Click="OnQuickPanelClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}"
                              Data="M1,4 H5 M9,4 H14 M1,11 H8 M12,11 H14 M7,2 A2,2 0 1 1 7,6 A2,2 0 1 1 7,2 Z M10,9 A2,2 0 1 1 10,13 A2,2 0 1 1 10,9 Z" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrayMenuLabelStyle}" Text="快速调节" />
                    </Grid>
                </Button>

                <ToggleButton Style="{StaticResource TrayMenuRowStyle}"
                              IsChecked="{Binding ShowLyrics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              automation:AutomationProperties.Name="显示桌面歌词">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}"
                              Data="M1,7.5 C4,1.5 11,1.5 14,7.5 C11,13.5 4,13.5 1,7.5 Z M9.5,7.5 A2,2 0 1 1 5.5,7.5 A2,2 0 1 1 9.5,7.5 Z" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrayMenuLabelStyle}" Text="显示桌面歌词" />
                        <Path Grid.Column="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1.5,7.1 L 5.2,10.6 L 12.5,3.1"
                              Fill="Transparent"
                              Stroke="{DynamicResource Accent.Primary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </ToggleButton>
                <ToggleButton Style="{StaticResource TrayMenuRowStyle}"
                              IsChecked="{Binding Locked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              automation:AutomationProperties.Name="锁定并点击穿透">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}"
                              Data="M4.5,6 V4 A3,3 0 0 1 10.5,4 V6 M3,6 H12 Q13,6 13,7 V13 Q13,14 12,14 H3 Q2,14 2,13 V7 Q2,6 3,6 Z M7.5,9 V11" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrayMenuLabelStyle}" Text="锁定并点击穿透" />
                        <Path Grid.Column="3"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1.5,7.1 L 5.2,10.6 L 12.5,3.1"
                              Fill="Transparent"
                              Stroke="{DynamicResource Accent.Primary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </ToggleButton>

                <Button Style="{StaticResource TrayMenuRowStyle}"
                        automation:AutomationProperties.Name="完整设置"
                        Click="OnSettingsClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}"
                              Data="M6,1 H9 L9.5,3 11,3.8 13,3.3 14.4,5.8 13,7.3 V8.7 L14.4,10.2 13,12.7 11,12.2 9.5,13 9,15 H6 L5.5,13 4,12.2 2,12.7 0.6,10.2 2,8.7 V7.3 L0.6,5.8 2,3.3 4,3.8 5.5,3 Z M10,8 A2.5,2.5 0 1 1 5,8 A2.5,2.5 0 1 1 10,8 Z" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrayMenuLabelStyle}" Text="完整设置" />
                    </Grid>
                </Button>

                <Border Height="1"
                        Margin="16,5"
                        Background="{DynamicResource Border.Hairline}"
                        SnapsToDevicePixels="True" />

                <Button Style="{StaticResource TrayMenuRowStyle}"
                        Tag="Danger"
                        automation:AutomationProperties.Name="退出词间"
                        Click="OnExitClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ExitIconStyle}"
                              Data="M7.5,1 V7.5 M4.3,3.5 A5.7,5.7 0 1 0 10.7,3.5" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrayMenuLabelStyle}" Text="退出词间" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
