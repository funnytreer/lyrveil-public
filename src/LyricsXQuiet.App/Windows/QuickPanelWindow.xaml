<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:pages="clr-namespace:LyricsXQuiet.App.Pages" x:Class="LyricsXQuiet.App.Windows.QuickPanelWindow"
    FontSize="12.5" Width="388" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    Icon="/Assets/lyrveil-app.ico" ShowInTaskbar="False" ResizeMode="NoResize" Title="词间快速调节"
    AutomationProperties.Name="词间快速调节">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="3,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="QuickSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style x:Key="PresetSegment" TargetType="RadioButton" BasedOn="{StaticResource SegmentedItem}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="ScopeSegment" TargetType="RadioButton" BasedOn="{StaticResource PresetSegment}">
            <Setter Property="Padding" Value="7,0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
        </Style>
        <Style x:Key="FooterAction" TargetType="ButtonBase">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ActionButtonTemplate}" />
        </Style>
        <Style x:Key="PickerAction" TargetType="ToggleButton" BasedOn="{StaticResource FooterAction}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="CandidateListItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="10,8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{DynamicResource Surface.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                    Value="{DynamicResource Surface.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface.Canvas}" CornerRadius="16"
        BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" Padding="15"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <ScrollViewer x:Name="PanelScroller" VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{DynamicResource Accent.Soft}" CornerRadius="7"
                        Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,9,0">
                        <TextBlock Text="词" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Foreground="{DynamicResource Accent.Primary}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28" Padding="0" BorderThickness="0" Background="Transparent" VerticalAlignment="Top"
                        Click="OnHideClick" AutomationProperties.Name="关闭快速调节" />
                    <StackPanel>
                        <TextBlock Text="{Binding State.TrackDisplay}" FontWeight="SemiBold" FontSize="14"
                            TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,4,0,0">
                            <Border Background="{DynamicResource Accent.Soft}" CornerRadius="5" Padding="7,2">
                                <TextBlock Text="{Binding State.SyncBadge}"
                                    Foreground="{DynamicResource Accent.Primary}" FontSize="11.5" />
                            </Border>
                            <Border Background="{DynamicResource Surface.Subtle}" CornerRadius="5" Padding="7,2"
                                Margin="4,0,0,0">
                                <TextBlock Text="{Binding State.TimingBadge}" FontSize="11.5"
                                    ToolTip="{Binding State.LyricsStatus}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
                <Button Content="{Binding State.NetEasePreciseSyncTitle}"
                    ToolTip="{Binding State.NetEasePreciseSyncDescription}" Click="OnSettingsClick"
                    HorizontalAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.ShowNetEasePreciseSyncHelp}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <UniformGrid Rows="1" Margin="0,10,0,0">
                    <ToggleButton Style="{StaticResource QuickSwitch}" Content="显示歌词"
                        IsChecked="{Binding Settings.ShowLyrics}" />
                    <ToggleButton Style="{StaticResource QuickSwitch}" Content="锁定穿透" IsChecked="{Binding Settings.Locked}" />
                    <ToggleButton Style="{StaticResource QuickSwitch}" Content="经过隐藏"
                        IsChecked="{Binding Settings.HoverHide}" />
                    <ToggleButton Style="{StaticResource QuickSwitch}" Content="双行显示"
                        IsChecked="{Binding Settings.DoubleLine}" />
                </UniformGrid>
                <Border Margin="0,8" Background="{DynamicResource Surface.Tray}" CornerRadius="8" Padding="3">
                    <UniformGrid Rows="1" x:Name="Presets">
                        <RadioButton Style="{StaticResource PresetSegment}" GroupName="Presets" Content="经典原版"
                            Click="OnPresetClick" />
                        <RadioButton Style="{StaticResource PresetSegment}" GroupName="Presets" Content="词间薄幕"
                            Click="OnPresetClick" />
                        <RadioButton Style="{StaticResource PresetSegment}" GroupName="Presets" Content="无界清墨"
                            Click="OnPresetClick" />
                        <RadioButton Style="{StaticResource PresetSegment}" GroupName="Presets" Content="影院双行"
                            Click="OnPresetClick" />
                        <RadioButton Style="{StaticResource PresetSegment}" GroupName="Presets" Content="夜读柔光"
                            Click="OnPresetClick" />
                    </UniformGrid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,1,0,4">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="背景深浅"
                                Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Width="43" TextAlignment="Right"
                                Text="{Binding Settings.BackgroundOpacity,StringFormat={}{0:P0}}" />
                            <Slider Style="{StaticResource ModernSlider}" Margin="12,0,4,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                Value="{Binding Settings.BackgroundOpacity}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="歌词字号" Foreground="{DynamicResource Text.Secondary}"
                                VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="FontSizeBackButton" Style="{StaticResource StepButton}" Content="A−" Width="30"
                                    Click="OnFontSmallerClick" />
                                <TextBlock Width="60" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding Settings.FontSize,StringFormat={}{0:0} px}" />
                                <Button x:Name="FontSizeForwardButton" Style="{StaticResource StepButton}" Content="A+" Width="30"
                                    Click="OnFontLargerClick" />
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Border.Hairline}" Margin="0,7" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" VerticalAlignment="Center" Background="{DynamicResource Surface.Tray}" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TrackScope" GroupName="Scope" Style="{StaticResource ScopeSegment}"
                                        Content="仅本曲" IsChecked="True" Click="OnScopeClick" />
                                    <RadioButton x:Name="PlayerScope" GroupName="Scope" Style="{StaticResource ScopeSegment}"
                                        Click="OnScopeClick">
                                        <TextBlock x:Name="PlayerOffsetSourceText" />
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid x:Name="PlayerOffsetPanel">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="PlayerOffsetBackButton" Style="{StaticResource StepButton}" Content="−" Width="27"
                                            Click="OnOffsetBackClick" />
                                        <TextBlock x:Name="PlayerOffsetValueText" Width="62" TextAlignment="Center"
                                            VerticalAlignment="Center" FontWeight="Normal" />
                                        <Button x:Name="PlayerOffsetForwardButton" Style="{StaticResource StepButton}" Content="+" Width="27"
                                            Click="OnOffsetForwardClick" />
                                        <Button x:Name="PlayerOffsetResetButton" Style="{StaticResource StepButton}" Content="重置" Width="40"
                                            Click="OnPlayerResetClick" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="TrackCalibrationPanel">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TrackCalibrationBackButton" Style="{StaticResource StepButton}" Content="−" Width="27"
                                            Click="OnTrackCalibrationBackClick" />
                                        <TextBlock x:Name="TrackCalibrationValueText" Width="62"
                                            TextAlignment="Center" VerticalAlignment="Center" FontWeight="Normal" />
                                        <Button x:Name="TrackCalibrationForwardButton" Style="{StaticResource StepButton}" Content="+" Width="27"
                                            Click="OnTrackCalibrationForwardClick" />
                                        <Button x:Name="TrackCalibrationResetButton" Style="{StaticResource StepButton}" Content="重置" Width="40"
                                            Click="OnTrackCalibrationResetClick" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <pages:CalibrationNotice x:Name="Calibration" />
                <UniformGrid Rows="1" Margin="0,7">
                    <ToggleButton x:Name="LyricsPickerToggle" Style="{StaticResource PickerAction}" Content="选择歌词"
                        Click="OnLyricsPickerToggleClick" />
                    <Button Style="{StaticResource FooterAction}" Content="导入 LRC" Click="OnImportClick" />
                    <Button Style="{StaticResource FooterAction}" Content="完整设置" Click="OnSettingsClick" />
                </UniformGrid>
                <Border x:Name="LyricsPickerPanel">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked,ElementName=LyricsPickerToggle}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="完整对比窗" Click="OnCompareClick" />
                                <Grid DockPanel.Dock="Right" Width="72" Margin="4,0">
                                    <TextBox x:Name="QueryArtist" ToolTip="歌手，回车搜索"
                                    AutomationProperties.Name="搜索歌手" KeyDown="OnQueryKeyDown" />
                                    <TextBlock Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="歌手" Foreground="{DynamicResource Text.Muted}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=QueryArtist}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <TextBox x:Name="QueryTitle" ToolTip="歌名，回车搜索" AutomationProperties.Name="搜索歌名"
                                    KeyDown="OnQueryKeyDown" />
                                    <TextBlock Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="歌名" Foreground="{DynamicResource Text.Muted}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=QueryTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <UniformGrid Rows="1" Margin="0,4">
                                <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="全部" Tag=""
                                    IsChecked="True" Click="OnSourceClick" />
                                <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="网易云"
                                    Tag="网易云音乐" Click="OnSourceClick" />
                                <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="QQ"
                                    Tag="QQ 音乐" Click="OnSourceClick" />
                                <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="酷狗"
                                    Tag="酷狗音乐" Click="OnSourceClick" />
                                <RadioButton Style="{StaticResource Pill}" GroupName="Sources" Content="LRCLIB"
                                    Tag="LRCLIB" Click="OnSourceClick" />
                            </UniformGrid>
                            <TextBlock x:Name="LyricsPickerStatusText" FontSize="11.5"
                                Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="LyricsCandidatesList" AutomationProperties.Name="歌词候选版本" Grid.Row="1"
                            Margin="0,9,0,0" MaxHeight="244" Background="Transparent" BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ItemContainerStyle="{StaticResource CandidateListItem}"
                            PreviewMouseLeftButtonUp="OnLyricsCandidateMouseUp"
                            PreviewKeyDown="OnLyricsCandidateKeyDown">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel AutomationProperties.Name="{Binding AccessibilityName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                Foreground="{DynamicResource Text.Primary}" FontSize="12"
                                                FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                Text="{Binding RecommendationText}"
                                                Foreground="{DynamicResource Accent.Primary}" FontSize="11.5" />
                                        </Grid>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding ArtistAndDuration}"
                                            Foreground="{DynamicResource Text.Secondary}" FontSize="11.5"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AlbumAndProvider}"
                                                Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                Text="{Binding QualitySummary}"
                                                Foreground="{DynamicResource Accent.Primary}" FontSize="11.5" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
