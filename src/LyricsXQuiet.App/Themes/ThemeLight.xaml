<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="Surface.Canvas" Color="#F6F8F7" options:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Sidebar" Color="#EFF3F1" options:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" options:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Subtle" Color="#E7EEEC" options:Freeze="True" />
    <SolidColorBrush x:Key="Surface.Tray" Color="#E5ECEA" options:Freeze="True" />
    <SolidColorBrush x:Key="Border.Hairline" Color="#DCE3E0" options:Freeze="True" />
