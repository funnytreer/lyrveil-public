    <SolidColorBrush x:Key="Text.Secondary" Color="#46524E" options:Freeze="True" />
    <SolidColorBrush x:Key="Text.Muted" Color="#6D7874" options:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Primary" Color="#0B7A6F" options:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#E3F3F0" options:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Border" Color="#99D5CC" options:Freeze="True" />
    <SolidColorBrush x:Key="Danger.Text" Color="#DC2626" options:Freeze="True" />
